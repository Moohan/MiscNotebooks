    "def encrypt_chi(chi):\n",
    "    encrypt_chi = chr(int(chi[6:8]) + 33)\n",
    "    encrypt_chi += chr(int(chi[0:2]) + 65)\n",
    "    encrypt_chi += chr(int(chi[2:3]) + 97)\n",
    "    encrypt_chi += chr(int(chi[8:10]) + 37)\n",
    "    encrypt_chi += chr(int(chi[4:6]) + 71)\n",
    "    return encrypt_chi\n",
    "    "
   ]
  }
